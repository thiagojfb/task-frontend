# Copie para .env.local (execução local) — em containers as variáveis vêm do compose.yaml
# Segredo do Auth.js (gere com: openssl rand -base64 32)
AUTH_SECRET=troque-este-segredo
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# API Java (execução local: porta do host; em container: http://task-backend:8080)
API_URL=http://localhost:8081

# Keycloak acessível pelo servidor Next (local: host; em container: http://keycloak:8080)
KEYCLOAK_URL_INTERNO=http://localhost:8180
KEYCLOAK_REALM=tarefas
KEYCLOAK_CLIENT_ID=tarefas-frontend
